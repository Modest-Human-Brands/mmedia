# System
PORT=3111
NODE_ENV=development

# Shared (Unprefixed)
# LiveKit (shared)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Scoped Service
# Service Auth & Endpoints
MOTIA_MMEDIA_API_KEY=
# Key MMedia sends to MDrive status callbacks (same as MDrive NITRO_MDRIVE_PRIVATE_SERVER_VALIDATION_KEY)
MOTIA_MMEDIA_DRIVE_API_KEY=
MOTIA_MMEDIA_SITE_URL=http://localhost:3000
MOTIA_MMEDIA_DRIVE_URL=http://localhost:3004
MOTIA_MMEDIA_CDN_HOST=http://localhost:8080
# S3-compatible storage (R2, S3, MinIO...) - CDN / Transformed Media Cache
MOTIA_MMEDIA_CDN_S3_ACCESS_KEY_ID=
MOTIA_MMEDIA_CDN_S3_SECRET_ACCESS_KEY=
MOTIA_MMEDIA_CDN_S3_ENDPOINT=
MOTIA_MMEDIA_CDN_S3_BUCKET=
MOTIA_MMEDIA_CDN_S3_REGION=auto
# S3-compatible storage (R2, S3, MinIO...) - Drive / Origin Media Storage
MOTIA_MMEDIA_DRIVE_S3_ACCESS_KEY_ID=
MOTIA_MMEDIA_DRIVE_S3_SECRET_ACCESS_KEY=
MOTIA_MMEDIA_DRIVE_S3_ENDPOINT=
MOTIA_MMEDIA_DRIVE_S3_BUCKET=
MOTIA_MMEDIA_DRIVE_S3_REGION=auto
